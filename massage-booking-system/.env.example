# Zkopíruj do .env pro lokální vývoj (na Renderu se tohle nastavuje jako
# env vars přímo ve webové službě, ne přes soubor).

DATABASE_URL=postgresql://user:password@localhost:5432/massage_booking
ADMIN_TASK_KEY=vygeneruj-nahodny-retezec
PUBLIC_BASE_URL=http://localhost:8000
BOOKING_CONFIRM_TTL_MINUTES=10
SLOT_GRANULARITY_MINUTES=30
SCARCITY_MIN_RATIO=0.2
SCARCITY_MAX_RATIO=0.4
APP_TIMEZONE=Europe/Prague

# SMS_SENDER_BACKEND=console pro lokální vývoj (appka SMS jen zaloguje,
# neposílá nic reálně a neutratí žádný kredit). Přepni na "smsbrana" až
# budeš mít reálný SMSbrana.cz účet a ověříš si první SMS na vlastní číslo.
SMS_SENDER_BACKEND=console
SMSBRANA_LOGIN=
SMSBRANA_PASSWORD=
